APP_NAME=PitchIntel AI
APP_ENV=development
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEFAULT_AI_PROVIDER=openai
MAX_UPLOAD_MB=20
FRONTEND_ORIGIN=http://localhost:5173
TAVILY_API_KEY=

# Phase 5: PostgreSQL (use SQLite locally if preferred)
DATABASE_URL=postgresql+psycopg://pitchintel:change-me@localhost:5432/pitchintel
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=60

# Phase 5: private S3 bucket; leave blank to disable object storage
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
